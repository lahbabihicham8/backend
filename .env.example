ENVIRONMENT=production
APP_NAME=khafeefa-api
API_BASE_URL=https://api.getkhafeefa.shop
FRONTEND_ORIGIN=https://getkhafeefa.shop
CORS_ORIGINS=https://getkhafeefa.shop

DATABASE_URL=postgres://getkhafeefa:getkhafeefa@khafeefa_database:5432/getkhafeefa?sslmode=disable
DATABASE_HOST=khafeefa_database
DATABASE_USER=getkhafeefa
DATABASE_PASSWORD=getkhafeefa
RUN_MIGRATIONS_ON_START=true

# Paste your Google Apps Script Web App URL here. No secret required.
ORDER_WEBHOOK_URL=

MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_MINFRAUD_ENDPOINT=https://minfraud.maxmind.com/minfraud/v2.0/insights
MAXMIND_MAX_RISK_SCORE=15
MAXMIND_ALLOW_TEST_PHONES=055000000
ALLOW_NON_KUWAIT_IPS=true
FRAUD_BLOCK_NON_KUWAIT=false
FRAUD_BLOCK_VPN=false
FRAUD_BLOCK_HIGH_RISK=false
FRAUD_API_FAILURE_MODE=allow

WHATSAPP_SUPPORT_NUMBER=
LOG_LEVEL=INFO

# ---- Admin dashboard ----
# These two are how you log into /admin on the storefront.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# 64+ random chars. Generate with:  openssl rand -hex 48
ADMIN_JWT_SECRET=replace-with-a-long-random-string
ADMIN_JWT_EXP_HOURS=24
# Comma-separated ISO country codes counted as "valid" traffic
# in the dashboard. Default Kuwait only. Add ",SA" to include KSA.
ADMIN_VALID_COUNTRIES=KW
# If MaxMind is unreachable, should we still count the click?
# true = friendlier locally / when MaxMind is mid-outage
# false = strict; never count anything we can't geo-verify
ADMIN_ALLOW_UNVERIFIED_GEO=true
